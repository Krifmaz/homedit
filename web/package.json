{
  "name": "homedit-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build && touch dist/.gitkeep",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
